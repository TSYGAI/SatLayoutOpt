# Python 缓存和构建产物
__pycache__/
*.py[cod]
.pytest_cache/

# 前端依赖和构建产物
node_modules/
.vite/
dist/
build/

# 本地配置和环境变量
.env
.env.*
!.env.example

# 运行数据、日志和测试结果；仅保留用于维护目录骨架的占位文件
data/**
!data/**/
!data/**/.gitkeep
logs/*
!logs/.gitkeep
test-results/**
!test-results/**/
!test-results/**/.gitkeep

# 本地开发工具文件
.idea/
.vscode/
